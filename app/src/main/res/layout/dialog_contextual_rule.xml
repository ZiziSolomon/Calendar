<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contextual_rule_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/contextual_rule_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/contextual_rule_type_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_margin"
            android:hint="@string/contextual_rule_type">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contextual_rule_type"
                style="@style/UnclickableEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </org.fossify.commons.views.MyTextInputLayout>

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/contextual_rule_pattern_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_margin">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contextual_rule_pattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true"
                android:textCursorDrawable="@null" />

        </org.fossify.commons.views.MyTextInputLayout>

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/contextual_rule_calendar_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_margin"
            android:hint="@string/contextual_rule_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contextual_rule_calendar"
                style="@style/UnclickableEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </org.fossify.commons.views.MyTextInputLayout>

        <!-- live preview: without it a wrong pattern fails silently (§1.5) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/contextual_rule_preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:layout_marginBottom="@dimen/small_margin"
            android:text="@string/contextual_preview_loading" />

        <LinearLayout
            android:id="@+id/contextual_rule_preview_samples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:layout_marginBottom="@dimen/activity_margin"
            android:alpha="0.7"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
