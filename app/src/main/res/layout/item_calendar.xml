<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_item_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selector">

    <RelativeLayout
        android:id="@+id/calendar_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/activity_margin">

        <LinearLayout
            android:id="@+id/calendar_text_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/calendar_color"
            android:orientation="vertical"
            android:paddingStart="@dimen/medium_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingEnd="@dimen/medium_margin"
            android:paddingBottom="@dimen/small_margin">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/calendar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Calendar" />

            <!-- the account, for synced calendars; same idiom as the event screen's calendar row -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/calendar_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textSize="@dimen/smaller_text_size"
                android:visibility="gone"
                tools:text="someone@gmail.com"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/calendar_color"
            android:layout_width="@dimen/color_sample_size"
            android:layout_height="@dimen/color_sample_size"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/medium_margin"
            android:layout_toStartOf="@+id/overflow_menu_icon"
            android:clickable="false" />

        <ImageView
            android:id="@+id/overflow_menu_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/activity_margin"
            android:src="@drawable/ic_three_dots_vector" />

        <View
            android:id="@+id/overflow_menu_anchor"
            style="@style/OverflowMenuAnchorStyle"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <View
        android:id="@+id/calendar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/activity_margin"
        android:visibility="gone" />
</FrameLayout>
